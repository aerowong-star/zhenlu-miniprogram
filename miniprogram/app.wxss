page {
  --brand: #197278;
  --brand-dark: #12575c;
  --brand-soft: #e6f3f2;
  --ink: #173042;
  --muted: #667985;
  --line: #dfe8eb;
  --surface: #ffffff;
  --background: #f4f7f8;
  background: var(--background);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
}

view, text, button, input, textarea, picker { box-sizing: border-box; }
button { margin: 0; }
button::after { border: none; }

.page { min-height: 100vh; padding: 32rpx 28rpx 64rpx; }
.page-title { font-size: 46rpx; line-height: 1.25; font-weight: 700; color: var(--ink); }
.page-subtitle { margin-top: 12rpx; color: var(--muted); line-height: 1.7; }
.section-title { margin: 36rpx 0 18rpx; font-size: 32rpx; font-weight: 650; }
.card { background: var(--surface); border: 1rpx solid var(--line); border-radius: 24rpx; padding: 28rpx; box-shadow: 0 10rpx 30rpx rgba(25, 63, 70, .05); }
.card + .card { margin-top: 20rpx; }
.primary-button, .secondary-button, .danger-button { min-height: 88rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: 600; }
.primary-button { background: var(--brand); color: white; }
.secondary-button { color: var(--brand-dark); background: var(--brand-soft); border: 1rpx solid #c5e2df; }
.danger-button { color: #a33a3a; background: #fff1f1; border: 1rpx solid #f1cccc; }
.primary-button[disabled] { opacity: .45; }
.button-row { display: flex; gap: 18rpx; margin-top: 24rpx; }
.button-row button { flex: 1; }
.label { display: block; margin: 24rpx 0 10rpx; color: #3e5664; font-size: 26rpx; font-weight: 600; }
.required::after { content: " *"; color: #c54a4a; }
.field { width: 100%; min-height: 84rpx; padding: 20rpx 22rpx; background: #fff; border: 1rpx solid var(--line); border-radius: 18rpx; color: var(--ink); }
textarea.field { min-height: 180rpx; }
.picker-field { color: var(--ink); }
.placeholder { color: #9aa8b0; }
.helper { margin-top: 10rpx; color: var(--muted); font-size: 24rpx; line-height: 1.6; }
.tag { display: inline-flex; align-items: center; padding: 8rpx 16rpx; border-radius: 999rpx; background: var(--brand-soft); color: var(--brand-dark); font-size: 24rpx; }
.empty { padding: 68rpx 28rpx; text-align: center; color: var(--muted); }
.safe-note { margin-top: 28rpx; padding: 22rpx; border-radius: 18rpx; background: #fff8e8; color: #725c28; font-size: 25rpx; line-height: 1.65; }
.fab { position: fixed; right: 32rpx; bottom: 150rpx; width: 104rpx; height: 104rpx; border-radius: 52rpx; background: var(--brand); color: white; font-size: 52rpx; line-height: 104rpx; text-align: center; box-shadow: 0 14rpx 32rpx rgba(25,114,120,.28); z-index: 5; }
