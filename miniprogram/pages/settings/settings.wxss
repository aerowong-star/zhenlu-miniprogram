.stats { display:grid; grid-template-columns:repeat(2,1fr); gap:14rpx; }
.stats .card { padding:22rpx 10rpx; text-align:center; }
.stats text { display:block; margin-top:6rpx; color:#74858e; font-size:24rpx; }
.stats .stat-value { font-size:48rpx; color:#197278; font-weight:700; }
.current { display:flex; justify-content:space-between; margin-top:18rpx; }
.current>text:first-child { color:#74858e; }
.current-value { font-weight:650; }
.setting { display:flex; align-items:center; justify-content:space-between; }
.setting text { display:block; }
.setting-title { font-weight:650; color:#173042; }
.setting view text:last-child { margin-top:8rpx; color:#7b8d95; font-size:23rpx; }
.setting>view:last-child { font-size:46rpx; color:#94a2a8; }
.copy text { display:block; }
.copy-title { margin-bottom:10rpx; font-weight:650; color:#173042; }
.copy-title.later { margin-top:26rpx; padding-top:24rpx; border-top:1rpx solid #e7edef; }
.copy>text:not(.copy-title) { color:#617680; line-height:1.7; }
.danger-title { color:#9b3f3f; }
.version { text-align:center; margin-top:46rpx; color:#9aa7ad; font-size:23rpx; }
