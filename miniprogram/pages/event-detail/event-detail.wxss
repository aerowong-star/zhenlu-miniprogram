.detail-hero{padding:36rpx}.detail-title{margin-top:22rpx;font-size:40rpx;font-weight:700}.detail-date{margin-top:12rpx;color:#74858e}.detail-list{padding:6rpx 28rpx}.detail-row{display:flex;justify-content:space-between;gap:30rpx;padding:24rpx 0}.detail-row+.detail-row{border-top:1rpx solid #e7edef}.detail-row>text:first-child{color:#74858e}.detail-value{text-align:right;font-weight:550;color:#173042}.detail-row.description{display:block}.detail-row.description .detail-value{display:block;margin-top:16rpx;text-align:left;line-height:1.7;font-weight:400}
.report-card{padding:0 22rpx;overflow:hidden}.report-row{display:grid;grid-template-columns:1.25fr 1fr 1fr;gap:12rpx;padding:20rpx 0;font-size:24rpx}.report-row+.report-row{border-top:1rpx solid #e7edef}.report-head{color:#74858e;font-weight:650}.report-row text:nth-child(n+2){text-align:right}.result{font-weight:650}.result.flagged{color:#a15c18}.demo-note{margin-top:20rpx;padding:20rpx;border-radius:18rpx;background:#eef4ff;color:#425b7b;font-size:25rpx}
