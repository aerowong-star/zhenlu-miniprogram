<view class="page summary-page" wx:if="{{summary}}">
  <view class="page-title">复诊摘要</view>
  <view class="page-subtitle">导出前选择需要显示的信息，并对照原记录确认内容。</view>
  <view class="privacy card">
    <view class="section-heading">隐私显示设置</view>
    <checkbox-group bindchange="privacyChange">
      <label><checkbox value="nickname" checked="{{privacy.showNickname}}" color="#197278" />显示患者称呼</label>
      <label><checkbox value="birthYear" checked="{{privacy.showBirthYear}}" color="#197278" />显示出生年份</label>
      <label><checkbox value="hospital" checked="{{privacy.showHospital}}" color="#197278" />显示医院信息</label>
    </checkbox-group>
    <view class="helper">患者称呼和出生年份默认隐藏。每次修改显示范围后都需要重新确认。</view>
  </view>
  <view class="summary-sheet card">
    <view class="sheet-title">{{summary.title}}</view>
    <view class="sheet-section"><view class="sheet-heading">患者信息</view><view>患者：{{summary.patient.nickname}}</view><view>出生年份：{{summary.patient.birthYear}}</view><view>相关疾病：{{summary.patient.diseaseName}}</view><view>当前阶段：{{summary.patient.stage}}</view><view>主要科室：{{summary.patient.department}}</view></view>
    <view class="sheet-section"><view class="sheet-heading">本次复诊</view><view>日期：{{summary.visit.date}}</view><view>医院：{{summary.visit.hospital}}</view><view>科室：{{summary.visit.department}}</view><view wx:if="{{summary.visit.doctor}}">医生：{{summary.visit.doctor}}</view><view>目的：{{summary.visit.purpose}}</view></view>
    <view class="sheet-section"><view class="sheet-heading">相关病程（{{summary.events.length}}）</view><view wx:if="{{!summary.events.length}}" class="muted">暂未选择病程材料</view><view class="summary-event" wx:for="{{summary.events}}" wx:key="id"><view class="event-title">{{item.date}} · {{item.typeLabel}} · {{item.title}}</view><view wx:if="{{item.description}}" class="muted">{{item.description}}</view><view wx:if="{{item.place}}" class="muted">{{item.place}}</view></view></view>
    <view class="sheet-section"><view class="sheet-heading">准备咨询的问题（{{summary.questions.length}}）</view><view wx:if="{{!summary.questions.length}}" class="muted">暂未添加问题</view><view class="summary-question" wx:for="{{summary.questions}}" wx:key="id">{{index + 1}}. {{item.content}}</view></view>
    <view class="disclaimer">{{summary.disclaimer}}</view>
  </view>
  <view class="edit-row"><text bindtap="editPlan">编辑计划</text><text bindtap="editMaterials">调整材料</text><text bindtap="editQuestions">修改问题</text></view>
  <view wx:if="{{confirmed}}" class="confirmed-banner">✓ 当前摘要已经确认，可以复制使用</view>
  <button wx:else class="primary-button" bindtap="confirm">我已核对，确认摘要</button>
  <button class="secondary-button copy-button" disabled="{{!confirmed}}" bindtap="copy">复制文字摘要</button>
</view>
