.patient-card{display:flex;align-items:center;gap:22rpx}.patient-card.active{border-color:#87c7c4;box-shadow:0 10rpx 30rpx rgba(25,114,120,.1)}.avatar{flex:none;width:84rpx;height:84rpx;line-height:84rpx;text-align:center;border-radius:28rpx;background:#e6f3f2;color:#197278;font-size:34rpx;font-weight:700}.patient-info{flex:1;min-width:0}.name-row{display:flex;align-items:center;gap:10rpx}.patient-name{font-size:31rpx;font-weight:650}.demo-tag{padding:6rpx 12rpx;border-radius:999rpx;background:#fff3d8;color:#8a6824;font-size:21rpx}.disease{margin-top:9rpx;color:#3c5663}.detail{margin-top:8rpx;color:#819098;font-size:23rpx}.edit{color:#197278;font-size:25rpx;padding:20rpx 0 20rpx 20rpx}.add{margin-top:28rpx}
