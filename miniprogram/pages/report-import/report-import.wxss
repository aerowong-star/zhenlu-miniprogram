.report-page{padding-bottom:100rpx}.step{margin-top:28rpx}.step-title{display:flex;align-items:center;gap:14rpx;font-size:32rpx;font-weight:700}.step-title>text{width:46rpx;height:46rpx;border-radius:23rpx;background:#197278;color:#fff;text-align:center;line-height:46rpx}.upload{height:360rpx;margin:24rpx 0;border:2rpx dashed #b8cace;border-radius:20rpx;background:#f8fbfb;display:flex;align-items:center;justify-content:center;text-align:center;color:#526c77;overflow:hidden}.upload image{width:100%;height:100%}.upload-icon{font-size:52rpx;color:#197278}.consent{display:flex;align-items:flex-start;gap:12rpx;margin:20rpx 0;color:#526c77;font-size:25rpx;line-height:1.6}.consent checkbox{transform:scale(.82);transform-origin:top left}.demo-button{margin-top:16rpx}.review{margin-top:36rpx}.demo-banner{margin-top:20rpx;padding:18rpx;border-radius:16rpx;background:#eef4ff;color:#425b7b;font-size:24rpx}.items-head{display:flex;align-items:center;justify-content:space-between}.items-head>view:last-child{color:#197278;font-weight:600}.item-card{margin-top:16rpx;padding:20rpx}.item-head{display:flex;justify-content:space-between;margin-bottom:16rpx;font-weight:650}.remove{color:#a33a3a}.compact{min-height:72rpx;padding:14rpx 16rpx}.item-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:12rpx}.final-check{margin-top:26rpx}
