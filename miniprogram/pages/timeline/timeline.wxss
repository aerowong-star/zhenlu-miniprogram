.timeline-page{padding-bottom:180rpx}.timeline-head{display:flex;justify-content:space-between;align-items:flex-start;gap:24rpx}.patient-switch{margin-top:8rpx;padding:12rpx 20rpx;border-radius:999rpx;background:#e6f3f2;color:#197278;font-size:24rpx}.filters{white-space:nowrap;margin:28rpx -28rpx 30rpx;padding:0 28rpx;width:auto}.filter{display:inline-block;margin-right:14rpx;padding:14rpx 24rpx;border-radius:999rpx;background:#fff;border:1rpx solid #dfe8eb;color:#6c7e87;font-size:25rpx}.filter.active{background:#197278;border-color:#197278;color:#fff}.event{display:flex;gap:20rpx}.rail{width:28rpx;display:flex;flex-direction:column;align-items:center}.dot{flex:none;margin-top:30rpx;width:20rpx;height:20rpx;border:5rpx solid #c8e5e2;border-radius:50%;background:#197278}.line{width:2rpx;flex:1;background:#cfe0e2}.event:last-child .line{background:transparent}.event-card{flex:1;margin-bottom:20rpx}.event-meta{display:flex;justify-content:space-between;align-items:center;color:#71838d;font-size:23rpx}.event-title{margin-top:14rpx;font-size:31rpx;font-weight:680}.event-description{margin-top:12rpx;color:#536a76;line-height:1.65}.event-place{margin-top:16rpx;padding-top:14rpx;border-top:1rpx solid #e7edef;color:#87959c;font-size:23rpx}.empty button{margin-top:24rpx}
